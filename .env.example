# ========================================================================
# CLIENT-SIDE ENVIRONMENT VARIABLES (Vite / Public)
# Prefixed with VITE_ to be bundled into the client application.
# ========================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_DATABASE_URL=

# Optional: Super Admin email override
VITE_SUPER_ADMIN_EMAIL=admin@bangalorekitchen.com

# Optional: API Base URL (leave empty for standard same-origin Vercel deployment)
VITE_API_BASE_URL=

# ========================================================================
# SERVER-SIDE ENVIRONMENT VARIABLES (Vercel Serverless / Private)
# Keep strictly secret on the server - DO NOT prefix with VITE_
# ========================================================================

# Twilio SMS OTP Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_SERVICE_SID=

# Cloudflare R2 Object Storage (Optional, for menu and banner images)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_DOMAIN=

# Optional AI Provider Key (Strictly Server-Side)
GEMINI_API_KEY=